{
  "name": "shopbooks",
  "version": "0.1.0",
  "private": true,
  "description": "Free, offline-first bookkeeping and sales-tax helper for small businesses",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
